# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node / Next.js
web/node_modules/
web/.next/
web/.env*
web/*.tsbuildinfo
web/next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Claude — the agentic layer (skills, agents, shared settings) is versioned like code, so it
# can be guarded by reconcile and reaches cloud sessions. Personal state stays local.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json

# Vercel
.vercel
# Secrets (local only)
.env.local
.env

# Session state (local only)
CLAUDE.local.md
DOMAIN_BRAND_RESEARCH.md

# Raw source data files (not part of repo)
*.XLSX
*.xlsx
rbi-analytics/
trading_system.db

# SQLite transient sidecars (signals.db itself IS tracked — these are not)
*.db-shm
*.db-wal

# Private local archive (never committed; the repo is public)
.local/
