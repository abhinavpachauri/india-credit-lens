{
  "id": "rbi_bankwise",
  "name": "RBI: bank-wise quarterly variables of SCBs (DBIE)",
  "order": 0,
  "kind": "primary",
  "note_why": "Each bank's credit from official RBI records (user, 2026-11-14; analysis/BANKWISE_SPEC.md). Primary since 2026-11-17 (phase 4, user: 'primary, with a model'): its per-bank signals are computed by the payments compute module (one per-bank mechanism, §8a) and its model's skeleton comes from an authored profile; surfaced inside the SIBC page.",
  "paths": {
    "data_dir": "analysis/rbi_bankwise",
    "releases": "analysis/rbi_bankwise/releases",
    "consolidated_csv": "analysis/rbi_bankwise/rbi_bankwise_consolidated.csv",
    "sheets": "analysis/pipelines/rbi_bankwise/sheets.json",
    "roster": "analysis/ontology/banks.json",
    "timeline": "analysis/rbi_bankwise/timeline.json",
    "inconsistencies": "analysis/rbi_bankwise/inconsistencies.json",
    "skeleton_profile": "analysis/rbi_bankwise/skeleton_profile.json",
    "system_model": "analysis/rbi_bankwise/merged/system_model.json"
  },
  "note_consolidated_csv": "Local only (git-ignored): ~2.8 million values for 2002 → 2026 are too many to commit, so the committed record is the saved quarters and this table is rebuilt from them by the first gate stage (user, 2026-11-14).",
  "calendar": {
    "first_quarter": "2015-03-31",
    "lag_ceiling_days": 165,
    "history_required": true,
    "note": "History from Mar 2015 (user, 2026-11-15: the SIBC history we hold does not reach further, and before Mar 2015 RBI's sector columns hold different content). Jun 2026 was on DBIE by 14 Nov 2026 (137 days); the 165-day ceiling stands until two clean cycles are measured."
  },
  "currency_stage": "calendar",
  "modules": {
    "fetch": "pipelines/rbi_bankwise/fetch.py",
    "reader": "pipelines/rbi_bankwise/reader.py",
    "consolidate": "pipelines/rbi_bankwise/consolidate.py",
    "calendar": "pipelines/rbi_bankwise/validate_calendar.py",
    "validate": "pipelines/rbi_bankwise/validate_bankwise.py",
    "registry": "pipelines/rbi_bankwise/build_registry.py"
  },
  "gate": [
    {
      "id": "consolidate",
      "label": "0.7 saved quarters → local table",
      "pipeline": "consolidate",
      "note": "Wrote",
      "derived": [
        "analysis/rbi_bankwise/timeline.json"
      ]
    },
    {
      "id": "consolidate_check",
      "label": "0.8 local table equals a rebuild",
      "pipeline": "consolidate",
      "args": [
        "--check"
      ],
      "note": "fresh"
    },
    {
      "id": "tests",
      "label": "T.  unit tests (pytest)",
      "builtin": "pytest"
    },
    {
      "id": "calendar",
      "label": "1b. newest quarter due + history count",
      "pipeline": "calendar",
      "note": "current"
    },
    {
      "id": "rbi_totals",
      "label": "1c. vs RBI's totals: column-wide fails, isolated flagged",
      "pipeline": "validate",
      "note": "5.1",
      "args": [
        "--write-flags"
      ],
      "derived": [
        "analysis/rbi_bankwise/inconsistencies.json"
      ]
    },
    {
      "id": "registry",
      "label": "4-reg. registry entries match the declared measures",
      "pipeline": "registry",
      "args": [
        "--check"
      ],
      "note": "match"
    },
    {
      "id": "signal_history",
      "label": "4a. signal history integrity",
      "core": "validate_signal_history"
    },
    {
      "id": "freshness",
      "label": "4b. signal freshness (DB)",
      "core": "check_signal_freshness",
      "note": "signals.db"
    },
    {
      "id": "skeleton",
      "label": "4c-pre. skeleton regen",
      "core": "skeleton",
      "derived": [
        "analysis/rbi_bankwise/merged/system_model.json"
      ]
    },
    {
      "id": "system_model",
      "label": "4c. system_model.json",
      "core": "validate_system_model",
      "requires": [
        "skeleton"
      ]
    },
    {
      "id": "system_state",
      "label": "4d. system_state (S3)",
      "core": "system_state",
      "requires": [
        "system_model"
      ],
      "derived": [
        "analysis/rbi_bankwise/merged/system_state_*.json"
      ]
    },
    {
      "id": "stamp_state",
      "label": "5.9 dashboard state band (DASHBOARD_SPEC §16)",
      "core": "stamp_state",
      "derived": [
        "web/public/data/rbi_bankwise_state.json"
      ]
    },
    {
      "id": "state_band",
      "label": "5.9b state band traceability",
      "core": "state_band"
    },
    {
      "id": "stamp_table",
      "label": "5.9c Layer 1 cut tables (DASHBOARD_SPEC §17)",
      "core": "stamp_table",
      "derived": [
        "web/public/data/rbi_bankwise_table.json",
        "web/public/data/rbi_bankwise_banks/*.json"
      ]
    },
    {
      "id": "cut_table",
      "label": "5.9d cut table traceability",
      "core": "cut_table"
    },
    {
      "id": "reconcile",
      "label": "5.  architecture reconcile",
      "core": "reconcile",
      "note": "drift"
    }
  ],
  "compute_module": "atm_pos",
  "period_key": "report_date",
  "schema": {
    "date_column": "report_date",
    "value_column": "value",
    "entity_columns": [
      "bank_name",
      "bank_category"
    ]
  },
  "cuts_module": "pipelines.rbi_bankwise.cuts"
}
